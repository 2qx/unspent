{
  "version": "0.2",
  "import": [
    "node_modules/@generalprotocols/cspell-dictionary/cspell.json"
  ],
  "patterns": [
    {
      "name": "cashAddresses",
      "pattern": "bitcoincash:[A-z0-9]+"
    },
    {
      "name": "rbchAddresses",
      "pattern": "bchreg:[A-z0-9]+"
    },
    {
      "name": "tbchAddresses",
      "pattern": "bchtest:[A-z0-9]+"
    },
    {
      "name": "legacyAddresses",
      "pattern": "1[A-z0-9]{33}"
    }
  ],
  // Ignore the following Regular Expression patterns.
  "ignoreRegExpList": [
    "cashAddresses",
    "rbchAddresses",
    "tbchAddresses",
    "legacyAddresses"
  ],
  "words": [
    "ACTIVEBYTECODE",
    "alice",
    "autotomata",
