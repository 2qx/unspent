pragma cashscript ^0.8.1;

// Rolling auction for an nft receipt, 
//
// new bidder refunds losing bidder,
// ends at some indeterminate future time,
// ... when all the "losers" have run out of money.
//
contract MemePool(

    // Address recieving proceeds
    bytes houseLockingBytecode,

    // Age of utxos required to end auction
    int time,

    // The next increment in points (%), each new bid must exceed
    //  5 points =  5% increase, 
    // 10 points = 10% increases, etc.
    int increment,
) {
    function bid() {

        // Using introspection, assure
        // bid amount increased by an value greater than increment,
        // the losing bidder recieves a full refund,
        // sets the new high bidder and bid value in NFT commitment as follows:
        // 
        // NFT: bidderLockingBytecode (32 bytes) : bidValue (8 bytes)
        //
        // Transaction:
        // [inputs]   [outputs]
        // auction -> auction [NFT]
        // new bid -> previous bidder (refund)
        // ... (s) // multiple input utxos allowed
        //         // only two outputs (house, loser) allowed
        //
        // Some dust or fee allowance may be provided by 
        // the bidders wallet to efficate the transaction.
        // The "committed" bid is less than the value on the contract.
        // If there is suffecent dust exists on the contract, a bidder may omit it.

        // Require that the nft commitment go back to the auction contract

        // get the 32-byte lockingBytescode for this auction contract
        bytes auctionLock = new LockingBytecodeP2SH32(hash256(this.activeBytecode));

        // The first input and output of a bid is always the auction contract
        require(tx.inputs[0].lockingBytecode == auctionLock);
        require(tx.outputs[0].lockingBytecode == auctionLock);

        // require no more than two outputs        
        require(tx.outputs.length == 2);

        // get the previous bidder and previous bid 
        bytes prevBidderLockinbBytecode = tx.inputs[0].nftCommitment.split(32)[0];
        int prevBidValue = int(tx.inputs[0].nftCommitment.split(32)[1]);

        // The bid is the minimum valid amount for the next zeroth output
        // The value on the contract may be higher, but cannot be less
        int bidValue = prevBidValue * (1 + increment/100);
        require(tx.outputs[0].value >= bidValue);

        // match the commitment value to the actual bid, 
        //   not the value calculated in script
        bytes newCommitment = tx.inputs[1].lockingBytecode+bytes(tx.outputs[0].value);
        require(tx.outputs[0].nftCommitment == newCommitment);

        // Discourage blatant self-bidding ...
        // using the previous NFT commitment
        require(tx.inputs[1].lockingBytecode != prevBidderLockinbBytecode);
        // using introspection
        require(tx.inputs[1].lockingBytecode != tx.outputs[1].lockingBytecode);
        // but nothing prevents a party from using a different address
        //
        // full permissioned bidding using bids signed by the house may prevent.

        // Check that the second output refunds the losing bidder
        require(tx.outputs[1].lockingBytecode == prevBidderLockinbBytecode);
        require(tx.outputs[1].value >= prevBidValue);      
    }

    // Anyone can hammer, after the alloted time has expired.
    //
    // Assure, using introspection, the winner receives the NFT receipt,
    // the house receives a utxo equal to or greater than the winning bid.
    //
    // The inputs must have aged sufficently to execute.
    //
    function hammer(){

        // require time to have elapsed
        require(tx.age >= time);

        // get the winning bidder and bid
        bytes winnerLockinbBytecode = tx.inputs[0].nftCommitment.split(32)[0];
        int winningBid = int(tx.inputs[0].nftCommitment.split(32)[1]);

        // send the proceeds to the house
        require(tx.outputs[0].lockingBytecode == houseLockingBytecode);
        require(tx.outputs[0].value >= winningBid);

        // send the receipt to the winner
        require(tx.outputs[1].lockingBytecode == winnerLockinbBytecode);
        require(tx.outputs[1].nftCommitment == winnerLockinbBytecode);

        // require no more than two outputs        
        require(tx.outputs.length == 2);
    }

    // 
    // function open();
    // [no op]
    // 
    // The auction is opened by receiving ONE utxo greater than (or equal to) the opening bid
    //   and a mutable NFT commitment encoded with the house lockingBytecode and opening bid value 

}