pragma cashscript ^0.10.0;

contract Succession(
  bytes tokenCategory,
  int executorAllowance,
) {

  //
  // relay (forward) funds  to the assignee designated by the commitment
  //

  // input[0] nft => output[0] nft
  // input[1] bch => output[1]  -> assignee
  //             |=> output[2] ?-> executor

  function execute() {

    // Limit to exactly two utxo inputs
    require(tx.inputs.length == 2);

    require(tx.outputs[0].tokenCategory == tokenCategory);
    require(tx.outputs[0].tokenCategory == tx.inputs[0].tokenCategory);
    
    require(tx.outputs[0].lockingBytecode == tx.inputs[0].lockingBytecode);
    require(tx.outputs[0].nftCommitment == tx.inputs[0].nftCommitment);

    require(tx.outputs[0].value == tx.inputs[0].value);

    bytes ntfCommitmentData = tx.inputs[0].nftCommitment;
    bytes assignee = ntfCommitmentData.split(32)[0];
    require(tx.outputs[1].lockingBytecode == assignee);

    // Get the value of the input
    int currentValue = tx.inputs[1].value;

    // Value paid to beneficiaries, minus executor allowance
    int distribution = currentValue - executorAllowance;
    require(tx.outputs[0].value >= distribution);

  }

  //
  // reassign the commitment to refer at a new assignee
  // 
  function assign(pubkey assignor, sig assignorSig, bytes assignee) {

    // require the old assignor sign for when assigning the enw destination.
    require(checkSig(assignorSig, assignor));

    // Output#0 preserves the NFT minting contract with same minting nft
    require(tx.outputs[0].tokenCategory == tokenCategory);
    require(tx.outputs[0].lockingBytecode == tx.inputs[0].lockingBytecode);
    require(tx.outputs[0].tokenCategory == tx.inputs[0].tokenCategory);

    require(tx.outputs[0].nftCommitment == assignee);
    require(tx.inputs[0].nftCommitment == assignor);

    // Limit to a single utxo input
    require(tx.outputs.length == 1);

  }
}